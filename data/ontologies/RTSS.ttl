@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix FOAF: <http://www.stiima.cnr.it/FOAF-excerpt#> .
@prefix JobL: <http://www.stiima.cnr.it/JobList#> .
@prefix JobD: <http://www.stiima.cnr.it/JobDescription#> .
@prefix SkAb: <http://www.stiima.cnr.it/SkAb#> .
@prefix Rien3: <http://www.stiima.cnr.it/RientraHC#> .
@prefix Rien: <http://www.stiima.cnr.it/RientraOnt3#> .
@prefix Rien2: <http://www.stiima.cnr.it/RientraOnt3Merged#> .
@prefix ICF-: <http://www.stiima.cnr.it/ICF-exc-coreset#> .

### 1. CORE DOMAIN CLASSES
FOAF:Person a owl:Class .
JobL:Job a owl:Class .
JobL:Job_Descriptor a owl:Class .
SkAb:Abilities a owl:Class .
SkAb:Skills a owl:Class .
Rien3:Health_Condition a owl:Class .
Rien3:HC_Descriptor a owl:Class .
ICF-:ICF a owl:Class .
ICF-:Body_functions rdfs:subClassOf ICF-:ICF .
ICF-:Body_structures rdfs:subClassOf ICF-:ICF .
ICF-:Activities_and_participation rdfs:subClassOf ICF-:ICF .

### 2. CORE PROPERTIES & RELATIONAL PATHS
# Job path: Job -> Job_Descriptor -> Ability / Skill
JobL:requires a owl:ObjectProperty ;
    rdfs:domain JobL:Job ;
    rdfs:range JobL:Job_Descriptor .

JobL:concerns a owl:ObjectProperty ;
    rdfs:domain JobL:Job_Descriptor ;
    rdfs:range SkAb:Abilities, SkAb:Skills .

# Job metadata
JobL:SOC_Code a owl:DatatypeProperty ;
    rdfs:domain JobL:Job ;
    rdfs:range xsd:string .

JobL:ONet_short_description a owl:DatatypeProperty ;
    rdfs:domain JobL:Job ;
    rdfs:range xsd:string .

# Semantic Bridge (Ability/Skill to ICF)
SkAb:isTranslatedWithICFCode a owl:ObjectProperty ;
    rdfs:domain SkAb:Abilities, SkAb:Skills ;
    rdfs:range ICF-:ICF .

# Person & Health Condition path: Person -> Health_Condition -> HC_Descriptor -> ICF
Rien3:isInHealthCondition a owl:ObjectProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range Rien3:Health_Condition .

Rien3:isDescribedBy a owl:ObjectProperty ;
    rdfs:domain Rien3:Health_Condition ;
    rdfs:range Rien3:HC_Descriptor .

Rien3:involvesICFCode a owl:ObjectProperty ;
    rdfs:domain Rien3:HC_Descriptor ;
    rdfs:range ICF-:ICF .

### 3. JOB SUBCLASSES (Target of rdfs:subClassOf* JobL:Job)
JobL:Animal_Control_Workers rdfs:subClassOf JobL:Job .
JobL:Audio_and_video_Technicians rdfs:subClassOf JobL:Job .
