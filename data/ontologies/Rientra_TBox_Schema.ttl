    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:first_name a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:surname a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

