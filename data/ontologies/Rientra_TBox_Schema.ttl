FOAF:Person_with_impairment a owl:Class ;
    rdfs:subClassOf FOAF:Person .

FOAF:TIN a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:ZIPcode a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:int .

FOAF:birthday a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:dateTime .

FOAF:city a owl:DatatypeProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

