Rien:isExtremelyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability is extremely critical for a person being evaluated in a specific profession."^^xsd:string ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills ;
    rdfs:range FOAF:Person .

Rien:isModeratelyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a moderate criticality for a person being evaluated in a specific profession."^^xsd:string ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills ;
    rdfs:range FOAF:Person .

Rien:isNotCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability presents no criticality for a person being evaluated in a specific profession."^^xsd:string ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills ;
    rdfs:range FOAF:Person .

Rien:isRelevantlyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a relevant criticality for a person being evaluated in a specific profession."^^xsd:string ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills ;
    rdfs:range FOAF:Person .

Rien:isSlightlyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability is slightly critical for a person being evaluated in a specific profession."^^xsd:string ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills ;
    rdfs:range FOAF:Person .

Rien:matchedJob a owl:ObjectProperty ;
    rdfs:domain Rien:Match ;
    rdfs:range JobL:Job .

<http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb> a owl:ObjectProperty .

ICF-:b134 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:b134,
        Rien2:Hand_Conditions,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sleep functions"^^xsd:string ;
    ICF-:description """General mental functions of periodic, reversible and selective physical and mental disengagement from one's immediate environment accompanied by characteristic physiological changes.
Inclusions: functions of amount of sleeping, and onset, maintenance and quality of sleep; functions involving the sleep cycle, such as in insomnia, hypersomnia and narcolepsy
Exclusions: consciousness functions (b110); energy and drive functions (b130); attention functions (b140); psychomotor functions (b147)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni mentali generali del disimpegno fisico e mentale Ã¢â‚¬â€ periodico, reversibile e selettivo Ã¢â‚¬â€ dal proprio ambiente circostante, accompagnato da caratteristici cambiamenti fisiologici.

Inclusioni: funzioni della quantitÃƒ  del sonno e dellÃ¢â‚¬â„¢inizio, del mantenimento e della qualitÃƒ  del sonno; funzioni che coinvolgono il ciclo del sonno, come nellÃ¢â‚¬â„¢insonnia, nellÃ¢â‚¬â„¢ipersonnia e nella narcolessia

Esclusioni: funzioni della coscienza (b110); funzioni dellÃ¢â‚¬â„¢energia e delle pulsioni (b130); funzioni dellÃ¢â‚¬â„¢attenzione (b140); funzioni psicomotorie (b147)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni del sonno"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hand_Conditions,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b1568 a owl:Class ;
    rdfs:label "Perceptual functions, other specified"^^xsd:string ;
    rdfs:subClassOf ICF-:b156 .

ICF-:b180 a ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:b180,
        Rien2:Low_Back_Pain,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Experience of self and time functions"^^xsd:string ;
    ICF-:description """Specific mental functions related to the awareness of one's identity, one's body, one's position in the reality of one's environment and of time.
Inclusions: functions of experience of self, body image and time"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni mentali specifiche correlate alla consapevolezza della propria identitÃƒ , del proprio corpo, della propria posizione nella realtÃƒ  del proprio ambiente e temporale.

Inclusione: funzioni dellÃ¢â‚¬â„¢esperienza del sÃƒÂ©, dellÃ¢â‚¬â„¢immagine corporea e del tempo"""^^xsd:string ;
    ICF-:nomeIta "Funzioni dellÃ¢â‚¬â„¢esperienza del sÃƒÂ© e del tempo"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Stroke,
        Rien2:Low_Back_Pain .

ICF-:b189 a owl:Class ;
    rdfs:label "Specific mental functions, other specified and unspecified"^^xsd:string ;
    ICF-:nomeIta "Funzioni mentali specifiche, altro specificato e non specificato"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions .

ICF-:b21028 a owl:Class ;
    rdfs:label "Quality of vision, other specified"^^xsd:string ;
    rdfs:subClassOf ICF-:b2102 .

ICF-:b240 a ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b240,
        Rien2:Hearing_Loss,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sensations associated with hearing and vestibular function"^^xsd:string ;
    ICF-:description """Sensations of dizziness, falling, tinnitus and vertigo.
Inclusions: sensations of ringing in ears, irritation in ear, aural pressure, nausea associated with dizziness or vertigo
Exclusions: vestibular functions (b235); sensation of pain (b280)"""^^xsd:string ;
    ICF-:descrizioneITA """Sensazioni di capogiro, caduta, tinnito e vertigine.

Inclusioni: sensazioni di ronzio auricolare, irritazione nellÃ¢â‚¬â„¢orecchio, pressione auricolare, nausea associata a capogiro o vertigine

Esclusioni: funzioni vestibolari (b235); sensazione di dolore (b280)"""^^xsd:string ;
    ICF-:nomeIta "Sensazioni associate alla funzione uditiva e vestibolare"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        Rien2:Hearing_Loss .

ICF-:b265 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:b265,
        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Touch function"^^xsd:string ;
    ICF-:description """Sensory functions of sensing surfaces and their texture or quality.
Inclusions: functions of touching, feeling of touch; impairments such as numbness, anaesthesia, tingling, paraesthesia and hyperaesthesia
Exclusions: sensory functions related to temperature and other stimuli (b270)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni sensoriali che permettono di percepire superfici e la loro struttura o qualitÃƒ .

Inclusioni: funzioni del toccare, sensazione del tocco; menomazioni come intorpidimento, anestesia, formicolio, parestesia e iperestesia

Esclusione: funzioni sensoriali correlate alla temperatura e ad altri stimoli (b270)"""^^xsd:string ;
    ICF-:nomeIta "Funzione del tatto"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        Rien2:Hand_Conditions .

ICF-:b28010 a ICF-:b2801,
        ICF-:b28010,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in head and neck"^^xsd:string ;
    ICF-:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the head and neck."^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b28014 a ICF-:b2801,
        ICF-:b28014,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in upper limb"^^xsd:string ;
    ICF-:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in either one or both upper limbs, including hands."^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b765 a ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b765,
        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Involuntary movement functions"^^xsd:string ;
    ICF-:description """Functions of unintentional, non- or semi-purposive involuntary contractions of a muscle or group of muscles.
Inclusions: involuntary contractions of muscles; impairments such as tremors, tics, mannerisms, stereotypies, motor perserveration, chorea, athetosis, vocal tics, dystonic movements and dyskinesia
Exclusions: control of voluntary movement functions (b760); gait pattern functions (b770)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni delle contrazioni involontarie non intenzionali e di quelle semi-finalizzate o non finalizzate di un muscolo o di un gruppo di muscoli.

Inclusioni: contrazioni involontarie dei muscoli; menomazioni come tremori, tic, manierismi, stereotipie, perseverazione motoria, corea, atetosi, tic vocali, movimenti distonici e discinesia

Esclusioni: funzioni di controllo del movimento volontario (b760); funzioni del pattern dellÃ¢â‚¬â„¢andatura (b770)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni del movimento involontario"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        Rien2:Hand_Conditions .

ICF-:b810 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:b810,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Protective functions of the skin"^^xsd:string ;
    ICF-:description """Functions of the skin for protecting the body from physical, chemical and biological threats.
Inclusions: functions of protecting against the sun and other radiation, photosensitivity, pigmentation, quality of skin, insulating function of skin, callus formation, hardening; impairments such as broken skin, ulcers, bedsores and thinning of skin
Exclusions: repair functions of the skin (b820); other functions of the skin (b830)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni della cute di protezione del corpo da minacce fisiche, chimiche e biologiche.

Inclusioni: funzioni di protezione dal sole e da altre radiazioni, fotosensibilitÃƒ , pigmentazione, qualitÃƒ  della cute; funzione isolante della cute, formazione di calli, indurimento; menomazioni come cute lacerata, ulcere, piaghe da decubito e assottigliamento della cute

Esclusioni: funzioni di riparazione della cute (b820); altre funzioni della cute (b830)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni protettive della cute"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:d155 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d155,
        Rien2:Hearing_Loss,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Acquiring skills"^^xsd:string ;
    ICF-:description """Developing basic and complex competencies in integrated sets of actions or tasks so as to initiate and follow through with the acquisition of a skill, such as manipulating tools or toys or playing games.

Inclusions: acquiring basic and complex skills"""@en ;
    ICF-:descrizioneITA """Sviluppare capacitÃƒ  basilari e complesse in insiemi integrati di azioni o compiti in modo da iniziare e portare a termine lÃ¢â‚¬â„¢acquisizione di unÃ¢â‚¬â„¢abilitÃƒ , come utilizzare strumenti o giocare a giochi come gli scacchi

Inclusioni: acquisire abilitÃƒ  basilari e complesse"""^^xsd:string ;
    ICF-:nomeIta "Acquisizione di abilitÃƒ "^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hearing_Loss,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:d163 a ICF-:Activities_and_participation,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d163,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Thinking"^^xsd:string ;
    ICF-:description """Formulating and manipulating ideas, concepts, and images, whether goal-oriented or not, either alone or with others, such as creating fiction, proving a theorem, playing with ideas, brainstorming, meditating, pondering, speculating, or reflecting.

Exclusions: solving problems (d175); making decisions (d177)"""@en ;
    ICF-:descrizioneITA """Formulare e trattare idee, concetti e immagini, finalizzati a uno scopo oppure no, sia da soli che insieme ad altri, come nel creare un racconto, dimostrare un teorema, giocare con le idee, fare Ã‚Â«brainstormingÃ‚Â», meditare, ponderare, speculare o riflettere.

Esclusioni: risoluzione di problemi (d175); prendere decisioni (d177)"""^^xsd:string ;
    ICF-:nomeIta "Pensiero"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation .

ICF-:d198 a owl:Class ;
    rdfs:label "Learning and applying knowledge, other specified"^^xsd:string ;
    ICF-:nomeIta "Apprendimento e applicazione delle conoscenze, altro specificato"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation .

ICF-:d210 a ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d210,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Undertaking a single task"^^xsd:string ;
    ICF-:description """Carrying out simple or complex and coordinated actions related to the mental and physical components of a single task, such as initiating a task, organizing time, space and materials for a task, pacing task performance, and carrying out, completing, and sustaining a task.

Inclusions: undertaking a simple or complex task; undertaking a single task independently or in a group

Exclusions: acquiring skills (d155); solving problems (d175); making decisions (d177); undertaking multiple tasks (d220)"""@en ;
    ICF-:descrizioneITA """Compiere delle azioni semplici o complesse e coordinate, correlate alle componenti fisiche e mentali di un compito singolo, come iniziare un compito, organizzare il tempo, lo spazio e i materiali necessari, stabilirne i tempi di esecuzione ed eseguire, completare e sostenere un compito.
Inclusioni: intraprendere un compito semplice o complesso; intraprendere un compito singolo autonomamente o in gruppo

Esclusioni: acquisizione di abilitÃƒ  (d155); risoluzione di problemi (d175); prendere decisioni (d177); intraprendere compiti articolati (d220)"""^^xsd:string ;
    ICF-:nomeIta "Intraprendere un compito singolo"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation .

ICF-:d220 a ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d220,
        Rien2:Hearing_Loss,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Undertaking multiple tasks"^^xsd:string ;
    ICF-:description """Carrying out simple or complex and coordinated actions as components of multiple, integrated and complex tasks in sequence or simultaneously.
Inclusions: undertaking multiple tasks; completing multiple tasks; undertaking multiple tasks independently and in a group

Exclusions: acquiring skills (d155); solving problems (d175); making decisions (d177); undertaking a single task (d210)"""@en ;
    ICF-:descrizioneITA """Compiere delle azioni semplici o complesse e coordinate, come componenti di compiti articolati, integrati e complessi in sequenza o simultaneamente.

Inclusioni: intraprendere compiti articolati; portare a termine compiti articolati; intraprendere compiti articolati autonomamente o in gruppo

Esclusioni: acquisizione di abilitÃƒ  (d155); risoluzione di problemi (d175); prendere decisioni (d177); intraprendere un compito singolo (d210)"""^^xsd:string ;
    ICF-:nomeIta "Intraprendere compiti articolati"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hearing_Loss .

ICF-:d230 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d230,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Carrying out daily routine"^^xsd:string ;
    ICF-:description """Carrying out simple or complex and coordinated actions in order to plan, manage and complete the requirements of day-to-day procedures or duties, such as budgeting time and making plans for separate activities throughout the day.

Inclusions: managing and completing the daily routine; managing one's own activity level

Exclusions: undertaking multiple tasks (d220)"""@en ;
    ICF-:descrizioneITA """Compiere delle azioni semplici o complesse e coordinate per pianificare, gestire e completare le attivitÃƒ  richieste dai procedimenti o dalle incombenze quotidiane, come organizzare il proprio tempo e pianificare le diverse attivitÃƒ  nel corso della giornata.

Inclusioni: gestire e completare la routine quotidiana; gestire il proprio tempo e le proprie attivitÃƒ 

Esclusione: intraprendere compiti articolati (d220)"""^^xsd:string ;
    ICF-:nomeIta "Eseguire la routine quotidiana"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:d335 a ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:d335,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Producing nonverbal messages"^^xsd:string ;
    ICF-:description """Using gestures, symbols and drawings to convey messages, such as shaking one's head to indicate disagreement or drawing a picture or diagram to convey a fact or complex idea.

Inclusions: producing body gestures, signs, symbols, drawings and photographs"""@en ;
    ICF-:descrizioneITA """Usare segni, simboli e disegni per comunicare significati, come scuotere la testa per indicare disaccordo o disegnare unÃ¢â‚¬â„¢immagine o un grafico per comunicare un fatto o unÃ¢â‚¬â„¢idea complessa.

Inclusioni: produrre gesti con il corpo, segni, simboli, disegni e fotografie"""^^xsd:string ;
    ICF-:nomeIta "Produrre messaggi non verbali"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury .

