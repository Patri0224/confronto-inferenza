        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Releasing"^^xsd:string ;
    ICF-:description "Using fingers and hands to let go or set free something so that it falls or changes position, such as when dropping an item of clothing or a piece of food for a pet."@en ;
