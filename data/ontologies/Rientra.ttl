Rien2:d3504 a owl:Class ;
    rdfs:label "Conversing with many people"^^xsd:string ;
    rdfs:subClassOf ICF-:d350,
        Rien2:Hearing_Loss .

Rien2:d4455 a owl:Class ;
    rdfs:label "Catching"^^xsd:string ;
    rdfs:subClassOf ICF-:d445,
        Rien2:Hand_Conditions .

Rien2:d950 a owl:Class ;
    rdfs:label "Political life and citizenship"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        Rien2:Hearing_Loss .

Rien2:s240 a owl:Class ;
    rdfs:label "Structure of external ear"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_structures,
        Rien2:Hearing_Loss .

Rien2:s250 a owl:Class ;
