        ICF-:b6200,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Urination"^^xsd:string ;
    ICF-:description """Functions of voiding the urinary bladder.
Inclusions: impairments such as in urine retention"""^^xsd:string ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
