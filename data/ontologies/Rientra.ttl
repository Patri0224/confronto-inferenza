        ICF-:b761,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spontaneous movements"^^xsd:string ;
    ICF-:description """Functions associated with frequency, fluency and complexity of total and individual body-part movements such as infant spontaneous movements and patterns of movement. Note: this code should be applied only to infants aged less than corrected age 6 months.
Exclusions: motor reflex functions (b750); involuntary movement reaction functions (b755); involuntary movement functions (b765)"""^^xsd:string ;
    ICF-:descrizioneITA "------ Non disponibile ------"^^xsd:string ;
    ICF-:nomeIta "Movimenti spontanei"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions .

ICF-:d240 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d240,
