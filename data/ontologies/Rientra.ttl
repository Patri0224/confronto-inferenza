        ICF-:Vocational_Rehabilitation,
        ICF-:b455,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Exercise tolerance functions"^^xsd:string ;
    ICF-:description """Functions related to respiratory and cardiovascular capacity as required for enduring physical exertion.
Inclusions: functions of physical endurance, aerobic capacity, stamina and fatiguability
Exclusions: functions of the cardiovascular system (b410-b429); haematological system functions (b430); respiration functions (b440); respiratory muscle functions (b445); additional respiratory functions (b450)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni correlate alla capacitÃƒ  respiratoria e cardiovascolare necessaria per sopportare lo sforzo fisico.

Inclusioni: funzioni di resistenza fisica, capacitÃƒ  aerobica, vigore e affaticabilitÃƒ 

Esclusioni: funzioni del sistema cardiovascolare (b410-b429); funzioni del sistema ematologico (b430); funzioni respiratorie (b440); funzioni del muscolo respiratorio (b445); ulteriori funzioni respiratorie (b450)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni di tolleranza dellÃ¢â‚¬â„¢esercizio fisico"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
