@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

FOAF:Person_with_impairment a owl:Class ;
    rdfs:subClassOf FOAF:Person ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty Rien3:isInHealthCondition ;
            owl:someValuesFrom Rien3:Health_Condition_with_impairment ] .

FOAF:TIN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:ZIPcode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:int .

FOAF:birthday a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:dateTime .

FOAF:city a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:country a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:first_name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

FOAF:surname a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain FOAF:Person ;
    rdfs:range xsd:string .

ICF-:description a owl:AnnotationProperty .

ICF-:descrizioneITA a owl:AnnotationProperty .

ICF-:nomeIta a owl:AnnotationProperty .

JobD:isSlightlyCriticalFor a owl:ObjectProperty ;
    rdfs:domain SkAb:Abilities,
        SkAb:Skills .

JobL:ONet_job_titles a owl:AnnotationProperty .

JobL:ONet_short_description a owl:AnnotationProperty .

JobL:SOC_Code a owl:AnnotationProperty .

