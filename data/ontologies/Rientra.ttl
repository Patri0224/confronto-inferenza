    rdfs:label "Vocational training"^^xsd:string ;
    ICF-:description "Engaging in all activities of a vocational programme and learning the curriculum material for preparation for employment in a trade, job or profession."@en ;
    ICF-:descrizioneITA "Impegnarsi in tutte le attivitÃƒ  di formazione professionale e apprendere il materiale del curriculum in previsione di intraprendere un mestiere, lavoro o professione."^^xsd:string ;
