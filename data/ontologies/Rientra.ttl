    rdfs:label "Relating with strangers"^^xsd:string ;
    ICF-:description "Engaging in temporary contacts and links with strangers for specific purposes, when asking for directions or other information, or making a purchase."@en ;
    ICF-:descrizioneITA "Avere contatti e legami temporanei con estranei per scopi specifici, come quando sichiede unÃ¢â‚¬â„¢indicazione o si effettua un acquisto."^^xsd:string ;
