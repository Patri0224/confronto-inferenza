ICF-:Body_functions a owl:Class ;
    ICF-:descrizioneITA """Le funzioni corporee sono le funzioni fisiologiche dei sistemi corporei (comprese le funzioni psicologiche).

Le menomazioni sono problemi nella funzione o nella struttura del corpo, intesi come una deviazione o una perdita significative."""^^xsd:string ;
    ICF-:nomeIta "Funzioni Corporee"^^xsd:string ;
    rdfs:subClassOf ICF-:ICF .

ICF-:Activities_and_participation a owl:Class ;
    ICF-:descrizioneITA """Definizioni:
LÃ¢â‚¬â„¢attivitÃƒ  ÃƒÂ¨ lÃ¢â‚¬â„¢esecuzione di un compito o di unÃ¢â‚¬â„¢azione da parte di un individuo.

La partecipazione ÃƒÂ¨ il coinvolgimento in una situazione di vita.

Le limitazioni dellÃ¢â‚¬â„¢attivitÃƒ  sono le difficoltÃƒ  che un individuo puÃƒÂ² incontrare nello svolgere delle attivitÃƒ .

Le restrizioni alla partecipazione sono i problemi che un individuo puÃƒÂ² sperimentare nel coinvolgimento nelle situazioni di vita."""^^xsd:string ;
    ICF-:nomeIta "AttivitÃƒ  e Partecipazione"^^xsd:string ;
    rdfs:subClassOf ICF-:ICF .

Rien2:Hand_Conditions a owl:Class ;
    rdfs:subClassOf ICF-:ICF_Core_set .

ICF-:Stroke a owl:Class ;
    rdfs:subClassOf ICF-:ICF_Core_set .

ICF-:Traumatic_Brain_Injury a owl:Class ;
    rdfs:subClassOf ICF-:ICF_Core_set .

ICF-:Spinal_Cord_Injury a owl:Class ;
    rdfs:subClassOf ICF-:ICF_Core_set .

Rien3:HC_Descriptor a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass ICF-:ICF ;
            owl:onProperty Rien3:involvesICFCode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

JobL:Job_Descriptor a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( SkAb:Abilities SkAb:Skills ) ] ;
            owl:onProperty JobL:concerns ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty JobL:hasScore ;
            owl:someValuesFrom xsd:int ] .

[] rdfs:comment "LessImport (0) - Activity&part"^^xsd:string .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#icf> ;
                    swrl:classPredicate ICF-:ICF ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl:var#des> ;
                            swrl:classPredicate Rien3:HC_Descriptor ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 <urn:swrl:var#hc> ;
                                    swrl:classPredicate Rien3:Health_Condition ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 <urn:swrl:var#hc> ;
                                            swrl:argument2 <urn:swrl:var#des> ;
                                            swrl:propertyPredicate Rien3:isDescribedBy ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 <urn:swrl:var#skab> ;
                                                    swrl:argument2 <urn:swrl:var#icf> ;
                                                    swrl:propertyPredicate SkAb:isTranslatedWithICFCode ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 <urn:swrl:var#p> ;
                                                            swrl:argument2 <urn:swrl:var#job> ;
                                                            swrl:propertyPredicate Rien:isEvaluatedForJob ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 <urn:swrl:var#jde> ;
                                                                    swrl:argument2 <urn:swrl:var#skab> ;
                                                                    swrl:propertyPredicate JobL:concerns ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                            swrl:argument1 <urn:swrl:var#skab> ;
                                                                            swrl:classPredicate [ a owl:Class ;
                                                                                    owl:unionOf ( SkAb:Abilities SkAb:Skills ) ] ] ;
                                                                    rdf:rest [ a swrl:AtomList ;
                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                    swrl:argument1 <urn:swrl:var#p> ;
                                                                                    swrl:argument2 <urn:swrl:var#hc> ;
                                                                                    swrl:propertyPredicate Rien3:isInHealthCondition ] ;
                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                            swrl:argument1 <urn:swrl:var#skab> ;
                                                                                            swrl:argument2 <urn:swrl:var#job> ;
                                                                                            swrl:propertyPredicate JobD:isSomewhatImportantFor ] ;
                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                    swrl:argument1 <urn:swrl:var#job> ;
                                                                                                    swrl:argument2 <urn:swrl:var#jde> ;
                                                                                                    swrl:propertyPredicate JobL:requires ] ;
                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                                                            swrl:argument1 <urn:swrl:var#des> ;
                                                                                                            swrl:argument2 <urn:swrl:var#icf> ;
                                                                                                            swrl:propertyPredicate Rien3:involvesICFCode ] ;
                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                    swrl:argument1 <urn:swrl:var#p> ;
                                                                                                                    swrl:argument2 true ;
                                                                                                                    swrl:propertyPredicate Rien2:isSelected ] ;
                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                            swrl:argument1 <urn:swrl:var#p> ;
                                                                                                                            swrl:classPredicate FOAF:Person ] ;
                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                            rdf:first [ a swrl:ClassAtom ;
                                                                                                                                    swrl:argument1 <urn:swrl:var#job> ;
                                                                                                                                    swrl:classPredicate JobL:Job ] ;
                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                    rdf:first [ a swrl:ClassAtom ;
                                                                                                                                            swrl:argument1 <urn:swrl:var#jde> ;
                                                                                                                                            swrl:classPredicate JobL:Job_Descriptor ] ;
                                                                                                                                    rdf:rest [ a swrl:AtomList ;
                                                                                                                                            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                                                                                                                    swrl:argument1 <urn:swrl:var#des> ;
                                                                                                                                                    swrl:argument2 <urn:swrl:var#x> ;
                                                                                                                                                    swrl:propertyPredicate Rien3:AP1qual ] ;
                                                                                                                                            rdf:rest [ a swrl:AtomList ;
                                                                                                                                                    rdf:first [ a swrl:BuiltinAtom ;
                                                                                                                                                            swrl:arguments [ a rdf:List ;
                                                                                                                                                                    rdf:first <urn:swrl:var#res> ;
                                                                                                                                                                    rdf:rest [ a rdf:List ;
                                                                                                                                                                            rdf:first <urn:swrl:var#x> ;
                                                                                                                                                                            rdf:rest [ a rdf:List ;
                                                                                                                                                                                    rdf:first 1 ;
                                                                                                                                                                                    rdf:rest () ] ] ] ;
                                                                                                                                                            swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply> ] ;
                                                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#skab> ;
                    swrl:argument2 <urn:swrl:var#res> ;
                    swrl:propertyPredicate Rien:hasSpecificCriticality ] ;
            rdf:rest () ] .

