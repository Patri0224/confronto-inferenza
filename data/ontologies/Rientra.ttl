JobL:Cabinet_makers_and_bench_carpenters a owl:Class ;
    rdfs:label "Cabinetmakers and Bench Carpenters"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Cabinet Assembler, Cabinet Builder, Cabinet Installer, Cabinetmaker, Cutter, Double End Tenon Operator, Frame Builder, Framer, Machine Operator, Woodworker"^^xsd:string ;
    JobL:ONet_short_description "Cut, shape, and assemble wooden articles or set up and operate a variety of woodworking machines, such as power saws, jointers, and mortisers to surface, cut, or shape lumber or to fabricate parts for wood products."^^xsd:string ;
    JobL:SOC_Code "51-7011.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:Construction_laborers a owl:Class ;
    rdfs:label "Construction laborers"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Bituminous Asphalt Technician, Construction Laborer, Construction Worker, Drop Crew Laborer, Equipment Operator (EO), Form Setter, Post Framer, Scaffolding Operator, Site Work Laborer, Toolman"^^xsd:string ;
    JobL:ONet_short_description "Perform tasks involving physical labor at construction sites. May operate hand and power tools of all types: air hammers, earth tampers, cement mixers, small mechanical hoists, surveying and measuring equipment, and a variety of other equipment and instruments. May clean and prepare sites, dig trenches, set braces to support the sides of excavations, erect scaffolding, and clean up rubble, debris and other waste materials. May assist other craft workers."^^xsd:string ;
    JobL:SOC_Code "47-2061.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:File_clerks a owl:Class ;
    rdfs:label "File Clerks"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Claims Clerk, Clerk, Documentation Specialist, File Clerk, Human Resources Assistant (HR Assistant), Manufacturing Clerk, Medical Records Clerk, Office Assistant, Police Records Clerk, Records Clerk"^^xsd:string ;
    JobL:ONet_short_description "File correspondence, cards, invoices, receipts, and other records in alphabetical or numerical order or according to the filing system used. Locate and remove material from file when requested."^^xsd:string ;
    JobL:SOC_Code "43-4071.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:Gem_and_diamond_workers a owl:Class ;
    rdfs:label "Gem and Diamond Workers"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Diamond Cutter, Diamond Grader, Diamond Picker, Diamond Polisher, Diamond Sawer, Diamond Setter, Facetor, Gemologist, Lapidarist, Quality Control Specialist"^^xsd:string ;
    JobL:ONet_short_description "Fabricate, finish, or evaluate the quality of gems and diamonds used in jewelry or industrial tools."^^xsd:string ;
    JobL:SOC_Code "51-9071.06"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:Receptionist_and_information_clerks a owl:Class ;
    rdfs:label "Receptionists and Information Clerks"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Clerk Specialist, Community Liaison, Front Desk Receptionist, Greeter, Member Service Representative, Office Assistant, Receptionist, Scheduler, Senior Receptionist, Unit Assistant"^^xsd:string ;
    JobL:ONet_short_description "Answer inquiries and provide information to the general public, customers, visitors, and other interested parties regarding activities conducted at establishment and location of departments, offices, and employees within the organization."^^xsd:string ;
    JobL:SOC_Code "43-4171.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:Travel_guides a owl:Class ;
    rdfs:label "Travel guides"^^xsd:string ;
    JobL:ONet_job_titles "Cruise Counselor, Guide, Mountain Bike Guide, River Guide, Tour Coordinator, Tour Director, Tour Escort, Tour Manager, Tour Operator, Tours Captain"^^xsd:string ;
    JobL:ONet_short_description "Plan, organize, and conduct long distance travel, tours, and expeditions for individuals and groups."^^xsd:string ;
    JobL:SOC_Code "39-7012.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:Word_Processors_and_Typists a owl:Class ;
    rdfs:label "Word Processors and Typists"^^xsd:string ;
    JobL:ONet_job_titles "Sample of reported job titles: Clerk Specialist, Clerk Typist, Keyboard Specialist, Management Services Technician, Office Technician, Principal Clerk Typist, Project Assistant, Stenographer, Typist, Word Processor"^^xsd:string ;
    JobL:ONet_short_description "Use word processor, computer or typewriter to type letters, reports, forms, or other material from rough draft, corrected copy, or voice recording. May perform other clerical duties as assigned."^^xsd:string ;
    JobL:SOC_Code "43-9022.00"^^xsd:string ;
    rdfs:subClassOf JobL:Job .

JobL:jde450 a JobL:Job_Descriptor,
        owl:NamedIndividual ;
