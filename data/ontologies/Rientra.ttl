ICF-:d4100 a ICF-:Spinal_Cord_Injury,
        ICF-:d410,
        ICF-:d4100,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Lying down"^^xsd:string ;
    ICF-:description """Getting into and out of a lying down position or changing body position, from horizontal to any other position, such as standing up or sitting down.

Inclusions: getting into a prostrate position"""@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d410 .

ICF-:d4102 a ICF-:Spinal_Cord_Injury,
        ICF-:d410,
        ICF-:d4102,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Kneeling"^^xsd:string ;
    ICF-:description "Getting into and out of a position where the body is supported by the knees with legs bent, such as during prayers, or changing body position from kneeling to any other position, such as standing up."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d410 .

ICF-:d4104 a ICF-:Spinal_Cord_Injury,
        ICF-:d410,
        ICF-:d4104,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Standing"^^xsd:string ;
    ICF-:description "Getting into and out of a standing position or changing body position from standing to any other position, such as lying down or sitting down."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d410 .

ICF-:d4105 a ICF-:Spinal_Cord_Injury,
        ICF-:d410,
        ICF-:d4105,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Bending"^^xsd:string ;
    ICF-:description "Tilting the back downwards or to the side, at the torso, such as in bowing or reaching down for an object."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d410 .

ICF-:d4106 a ICF-:Spinal_Cord_Injury,
        ICF-:d410,
        ICF-:d4106,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shifting the body's centre of gravity"^^xsd:string ;
    ICF-:description """Adjusting or moving the weight of the body from one position to another while sitting, standing or lying, such as moving from one foot to another while standing.

Exclusions: transferring oneself (d420); walking (d450)"""@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d410 .

ICF-:d415 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        ICF-:d415,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Maintaining a body position"^^xsd:string ;
    ICF-:description """Staying in the same body position as required, such as remaining seated or remaining standing for carrying out a task, in play, work or school.

Inclusions: maintaining a lying, squatting, kneeling, sitting and standing position"""@en ;
    ICF-:descrizioneITA """Rimanere nella stessa posizione corporea come richiesto, come rimanere seduti o in piedi per lavoro o a scuola.

Inclusioni: mantenere una posizione sdraiata, accovacciata, inginocchiata, seduta ed eretta"""^^xsd:string ;
    ICF-:nomeIta "Mantenere una posizione corporea"^^xsd:string ;
    rdfs:subClassOf ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:d4500 a ICF-:Spinal_Cord_Injury,
        ICF-:d450,
        ICF-:d4500,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking short distances"^^xsd:string ;
    ICF-:description "Walking for less than a kilometre, such as walking around rooms or hallways, within a building or for short distances outside."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d450 .

ICF-:d4501 a ICF-:Spinal_Cord_Injury,
        ICF-:d450,
        ICF-:d4501,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking long distances"^^xsd:string ;
    ICF-:description "Walking for more than a kilometre, such as across a village or town, between villages or across open areas."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d450 .

ICF-:d4502 a ICF-:Spinal_Cord_Injury,
        ICF-:d450,
        ICF-:d4502,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking on different surfaces"^^xsd:string ;
    ICF-:description "Walking on sloping, uneven, or moving surfaces, such as on grass, gravel or ice and snow, or walking aboard a ship, train or other vehicle."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d450 .

ICF-:d4503 a ICF-:Spinal_Cord_Injury,
        ICF-:d450,
        ICF-:d4503,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking around obstacles"^^xsd:string ;
    ICF-:description "Walking in ways required to avoid moving and immobile objects, people, animals, and vehicles, such as walking around a marketplace or shop, around or through traffic or other crowded areas."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d450 .

ICF-:d465 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
