    rdfs:label "Pulling"^^xsd:string ;
    ICF-:description "Using fingers, hands and arms to bring an object towards oneself, or to move it from place to place, such as when pulling on a string or pulling a door closed."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d445,
        Rien2:Hand_Conditions .

ICF-:d4451 a ICF-:Spinal_Cord_Injury,
