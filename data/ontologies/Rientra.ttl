        owl:NamedIndividual ;
    rdfs:label "Temperament and personality functions"^^xsd:string ;
    ICF-:description """General mental functions of constitutional disposition of the individual to react in a particular way to situations, including the set of mental characteristics that makes the individual distinct from others.
Inclusions: functions of extraversion, introversion, agreeableness, conscientiousness, psychic and emotional stability, and openness to experience; optimism; novelty seeking; confidence; trustworthiness
Exclusions: intellectual functions (b117); energy and drive functions (b130); psychomotor functions (b147); emotional functions (b152)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni mentali generali del temperamento proprio dellÃ¢â‚¬â„¢individuo che lo portano a reagire in un particolare modo alle situazioni, inclusa la serie di caratteristiche mentali che rende un individuo distinto dagli altri.

Inclusioni: funzioni di estroversione, introversione, giovialitÃƒ , coscienziositÃƒ , stabilitÃƒ  emotiva e psichica e apertura alle esperienze; ottimismo; ricerca delle novitÃƒ ; fiducia; affidabilitÃƒ 

Esclusioni: funzioni intellettive (b117); funzioni dellÃ¢â‚¬â„¢energia e
delle pulsioni (b130); funzioni psicomotorie (b147); funzioni
emozionali (b152)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni del temperamento e della personalitÃƒ "^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:Vocational_Rehabilitation,
        Rien2:Hearing_Loss,
        Rien2:Low_Back_Pain .

