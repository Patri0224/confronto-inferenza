    rdfs:label "Informal education"^^xsd:string ;
    ICF-:description "Learning at home or in some other non-institutional setting, such as learning crafts and other skills from parents or family members, or home schooling."@en ;
    ICF-:descrizioneITA "Apprendimento a casa o in qualche altro ambiente non-istituzionalizzato, come nellÃ¢â‚¬â„¢imparare un mestiere o altre abilitÃƒ  dai propri genitori o membri della famiglia, o nellÃ¢â‚¬â„¢istruzione a casa."^^xsd:string ;
