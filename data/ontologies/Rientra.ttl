        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Grasping"^^xsd:string ;
    ICF-:description "Using one or both hands to seize and hold something, such as when grasping a tool or a door knob."@en ;
