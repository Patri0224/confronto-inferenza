    rdfs:subClassOf ICF-:b1671 .

ICF-:b16711 a ICF-:b1671,
        ICF-:b16711,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Expression of written language"^^xsd:string ;
    ICF-:description "Mental functions necessary to produce meaningful written messages."^^xsd:string ;
    rdfs:subClassOf ICF-:b1671 .

ICF-:b21020 a ICF-:b2102,
        ICF-:b21020,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Light sensitivity"^^xsd:string ;
    ICF-:description """Seeing functions of sensing a minimum amount of light (light minimum), and the minimum difference in intensity (light difference).
Inclusions: functions of dark adaptation; impairments such as night blindness (hyposensitivity to light) and photophobia (hypersensitivity to light)"""^^xsd:string ;
    rdfs:subClassOf ICF-:b2102 .

ICF-:b21023 a ICF-:b2102,
        ICF-:b21023,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Visual picture quality"^^xsd:string ;
    ICF-:description """Seeing functions involving the quality of the picture.
Inclusions: impairments such as in seeing stray lights; affected picture quality (floaters or webbing); picture distortion, and seeing stars or flashes"""^^xsd:string ;
    rdfs:subClassOf ICF-:b2102 .

ICF-:b215 a ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b215,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Functions of structures adjoining the eye"^^xsd:string ;
    ICF-:description """Functions of structures in and around the eye that facilitate seeing functions.
Inclusions: functions of internal muscles of the eye, eyelid, external muscles of the eye, including voluntary and tracking movements and fixation of the eye, lachrymal glands, accommodation, pupillary reflex; impairments such as in nystagmus, xerophthalmia and ptosis
Exclusions: seeing functions (b210); Chapter 7 Neuromusculoskeletal and Movement-related Functions (b7)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni delle strutture interne e attorno allÃ¢â‚¬â„¢occhio che facilitano le funzioni della vista.

Inclusioni: funzioni dei muscoli interni dellÃ¢â‚¬â„¢occhio, della palpebra, dei muscoli esterni dellÃ¢â‚¬â„¢occhio, inclusi i movimenti volontari e di rilevamento, e aggiustamento dellÃ¢â‚¬â„¢occhio, ghiandole lacrimali, accomodazione, riflesso pupillare; menomazioni come nel nistagmo, xeroftalmia e ptosi

Esclusioni: funzioni della vista (b210); Capitolo 7 Ã¢â‚¬â€œ Funzioni
neuro-muscoloscheletriche e correlate al movimento"""^^xsd:string ;
    ICF-:nomeIta "Funzioni delle strutture adiacenti allÃ¢â‚¬â„¢occhio"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury .

ICF-:b2300 a ICF-:b230,
        ICF-:b2300,
        Rien2:Hearing_Loss,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sound detection"^^xsd:string ;
    ICF-:description "Sensory functions relating to sensing the presence of sounds."^^xsd:string ;
    rdfs:subClassOf ICF-:b230,
        Rien2:Hearing_Loss .

ICF-:b255 a ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b255,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Smell function"^^xsd:string ;
    ICF-:description """Sensory functions of sensing odours and smells.
Inclusions: functions of smelling, olfactory functions; anosmia, hyposmia"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni sensoriali del percepire odori e aromi.

Inclusioni: funzioni olfattive; menomazioni come anosmia o iposmia"""^^xsd:string ;
    ICF-:nomeIta "Funzione dellÃ¢â‚¬â„¢olfatto"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury .

ICF-:b260 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b260,
        Rien2:Hand_Conditions,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Proprioceptive function"^^xsd:string ;
    ICF-:description """Sensory functions of sensing the relative position of body parts.
Inclusions: functions of statesthesia and kinaesthesia
Exclusions: vestibular functions (b235); sensations related to muscles and movement functions (b780)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni sensoriali del percepire la posizione relativa delle parti del corpo.

Inclusioni: funzioni di statestesia e cinestesia

Esclusioni: funzioni vestibolari (b235); sensazioni correlate alle funzioni muscolari e del movimento (b780)"""^^xsd:string ;
    ICF-:nomeIta "Funzione propriocettiva"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        Rien2:Hand_Conditions,
        Rien2:Low_Back_Pain,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b28011 a ICF-:b2801,
        ICF-:b28011,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in chest"^^xsd:string ;
    ICF-:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the chest."^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b28012 a ICF-:b2801,
        ICF-:b28012,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in stomach or abdomen"^^xsd:string ;
    ICF-:description """Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the stomach or abdomen.
Inclusions: pain in the pelvic region"""^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b28013 a ICF-:b2801,
        ICF-:b28013,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in back"^^xsd:string ;
    ICF-:description """Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the back.
Inclusions: pain in the trunk; low backache"""^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b28015 a ICF-:b2801,
        ICF-:b28015,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in lower limb"^^xsd:string ;
    ICF-:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in either one or both lower limbs, including feet."^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b28016 a ICF-:b2801,
        ICF-:b28016,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in joints"^^xsd:string ;
    ICF-:description """Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in one or more joints, including small and big joints.
Inclusions: pain in the hip; pain in the shoulder"""^^xsd:string ;
    rdfs:subClassOf ICF-:b2801 .

ICF-:b2803 a ICF-:b280,
        ICF-:b2803,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Radiating pain in a dermatome"^^xsd:string ;
    ICF-:description "Unpleasant sensation indicating potential or actual damage to some body structure located in areas of skin served by the same nerve root."^^xsd:string ;
    rdfs:subClassOf ICF-:b280 .

ICF-:b2804 a ICF-:b280,
        ICF-:b2804,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Radiating pain in a segment or region"^^xsd:string ;
    ICF-:description "Unpleasant sensation indicating potential or actual damage to some body structure located in areas of skin in different body parts not served by the same nerve root."^^xsd:string ;
    rdfs:subClassOf ICF-:b280 .

ICF-:b410 a ICF-:Stroke,
        ICF-:b410,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Heart functions"^^xsd:string ;
    rdfs:subClassOf ICF-:Stroke .

ICF-:b415 a ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:b415,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Blood vessel functions"^^xsd:string ;
    ICF-:description """Functions of transporting blood throughout the body.
Inclusions: functions of arteries, capillaries and veins; vasomotor function; functions of pulmonary arteries, capillaries and veins; functions of valves of veins, blockage or constriction of arteries; atherosclerosis, arteriosclerosis, thromboembolism and varicose veins
Exclusions: heart functions (b410); blood pressure functions (b420); haematological system functions (b430); exercise tolerance functions (b455)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni di trasporto del sangue in tutto il corpo.

Inclusioni: funzioni delle arterie, dei capillari e delle vene; funzione vasomotoria; funzioni delle arterie, dei capillari e delle vene polmonari; funzioni delle valvole delle vene; menomazioni come nel blocco o restringimento delle arterie; aterosclerosi, arteriosclerosi, tromboembolia e vene varicose

Esclusioni: funzioni del cuore (b410); funzioni della pressione sanguigna (b420); funzioni del sistema ematologico (b430); funzioni di tolleranza dellÃ¢â‚¬â„¢esercizio fisico (b455)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni dei vasi sanguigni"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Stroke,
        Rien2:Hand_Conditions,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b420 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b420,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Blood pressure functions"^^xsd:string ;
    ICF-:description """Functions of maintaining the pressure of blood within the arteries.
Inclusions: functions of maintenance of blood pressure; increased and decreased blood pressure; impairments such as in hypotension, hypertension and postural hypotension
Exclusions: heart functions (b410); blood vessel functions (b415); exercise tolerance functions (b455)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni di mantenimento della pressione del sangue nelle arterie.

Inclusioni: funzioni di mantenimento della pressione del sangue; aumento e calo della pressione sanguigna; menomazioni come nellÃ¢â‚¬â„¢ipotensione, ipertensione e ipotensione posturale

Esclusioni: funzioni del cuore (b410); funzioni dei vasi sanguigni (b415); funzioni di tolleranza dellÃ¢â‚¬â„¢esercizio fisico (b455)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni della pressione sanguigna"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury .

ICF-:b440 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:b440,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Respiration functions"^^xsd:string ;
    ICF-:description """Functions of inhaling air into the lungs, the exchange of gases between air and blood, and exhaling air.
Inclusions: functions of respiration rate, rhythm and depth; impairments such as apnoea, hyperventilation, irregular respiration, paradoxical respiration, and bronchial spasm, and as in pulmonary emphysema; reduction in airflow through upper and lower airways
Exclusions: respiratory muscle functions (b445); additional respiratory functions (b450); exercise tolerance functions (b455)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni di inalazione di aria nei polmoni, lo scambio di gas tra aria e sangue e lÃ¢â‚¬â„¢esalazione dellÃ¢â‚¬â„¢aria.

Inclusioni: funzioni di frequenza, ritmo e profonditÃƒ  di respirazione; menomazioni come apnea, iperventilazione, respirazione irregolare, respiro paradosso e spasmo bronchiale, e come nellÃ¢â‚¬â„¢enfisema polmonare

Esclusioni: funzioni del muscolo respiratorio (b445); ulteriori funzioni respiratorie (b450); funzioni di tolleranza dellÃ¢â‚¬â„¢esercizio fisico (b455)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni respiratorie"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b445 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:b445,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Respiratory muscle functions"^^xsd:string ;
    ICF-:description """Functions of the muscles involved in breathing.
Inclusions: functions of thoracic respiratory muscles; functions of the diaphragm; functions of accessory respiratory muscles
Exclusions: respiration functions (b440); additional respiratory functions (b450); exercise tolerance functions (b455)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni dei muscoli coinvolti nella respirazione.

Inclusioni: funzioni dei muscoli respiratori toracici; funzioni del diaframma; funzioni dei muscoli respiratori accessori

Esclusioni: funzioni respiratorie (b440); ulteriori funzioni respiratorie (b450); funzioni di tolleranza dellÃ¢â‚¬â„¢esercizio fisico (b455)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni del muscolo respiratorio"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury .

ICF-:b510 a ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b510,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Ingestion functions"^^xsd:string ;
    ICF-:description """Functions related to taking in and manipulating solids or liquids through the mouth into the body.
Inclusions: functions of sucking, chewing and biting, manipulating food in the mouth, salivation, swallowing, burping, regurgitation, spitting and vomiting; impairments such as dysphagia, aspiration of food, aerophagia, excessive salivation, drooling and insufficient salivation
Exclusions: sensations associated with digestive system (b535)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni correlate allÃ¢â‚¬â„¢assunzione di solidi o liquidi nellÃ¢â‚¬â„¢organismo per via orale.

Inclusioni: funzioni di succhiare, masticare e mordere, spostare il cibo nella bocca, salivazione, deglutizione, eruttare, rigurgitare, sputare e vomitare; menomazioni come disfagia, aspirazione di cibo, aerofagia, salivazione eccessiva, sbavare e salivazione insufficiente

Esclusione: sensazioni associate allÃ¢â‚¬â„¢apparato digerente (b535)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni di ingestione"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury .

ICF-:b525 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b525,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Defecation functions"^^xsd:string ;
    ICF-:description """Functions of elimination of wastes and undigested food as faeces and related functions.
Inclusions: functions of elimination, faecal consistency, frequency of defecation; faecal continence, flatulence; impairments such as constipation, diarrhoea, watery stool and anal sphincter incompetence or incontinence
Exclusions: digestive functions (b515); assimilation functions (b520); sensations associated with the digestive system (b535)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni dellÃ¢â‚¬â„¢eliminazione delle scorie e del cibo non digerito come feci e funzioni correlate.

Inclusioni: funzioni di eliminazione, consistenza fecale, frequenza della defecazione, continenza fecale, flatulenza; menomazioni come costipazione, diarrea, feci acquose e insufficienza dello sfintere anale o incontinenza

Esclusioni: funzioni di digestione (b515); funzioni di assimilazione (b520); sensazioni associate allÃ¢â‚¬â„¢apparato digerente (b535)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni di defecazione"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:Stroke,
        ICF-:Traumatic_Brain_Injury,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b530 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:b530,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Weight maintenance functions"^^xsd:string ;
    ICF-:description """Functions of maintaining appropriate body weight, including weight gain during the developmental period.
Inclusions: functions of maintenance of acceptable Body Mass Index (BMI); and impairments such as underweight, cachexia, wasting, overweight, emaciation and such as in primary and secondary obesity
Exclusions: assimilation functions (b520); general metabolic functions (b540); endocrine gland functions (b555)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni del mantenimento dellÃ¢â‚¬â„¢appropriato peso corporeo, incluso lÃ¢â‚¬â„¢aumento di peso durante il periodo dello sviluppo.

Inclusioni: funzioni del mantenimento di un accettabile Indice di Massa Corporea (BMI, Body Mass Index); menomazioni come essere sottopeso, cachessia, deperimento, sovrappeso, emaciazione e obesitÃƒ  primaria e secondaria

Esclusioni: funzioni di assimilazione (b520); funzioni metaboliche generali (b540); funzioni delle ghiandole endocrine (b555)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni di mantenimento del peso"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        Rien2:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ICF-:b550 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:b550,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Thermoregulatory functions"^^xsd:string ;
    ICF-:description """Functions of the regulation of body temperature.
Inclusions: functions of maintenance of body temperature; impairments such as hypothermia, hyperthermia
Exclusions: general metabolic functions (b540); endocrine gland functions (b555)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni della regolazione della temperatura del corpo.

Inclusioni: funzioni di mantenimento della temperatura corporea; menomazioni come ipotermia, ipertermia

Esclusioni: funzioni metaboliche generali (b540); funzioni delle ghiandole endocrine (b555)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni di termoregolazione"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury .

ICF-:b555 a ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury,
        ICF-:b555,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Endocrine gland functions"^^xsd:string ;
    ICF-:description """Functions of production and regulation of hormonal levels in the body, including cyclical changes.
Inclusions: functions of hormonal balance, hyperpituitarism, hypopituitarism, hyperthyroidism, hypothyroidism, hyperadrenalism, hypoadrenalism, hyperparathyroidism, hypoparathyroidism, hypergonadism, hypogonadism
Exclusions: general metabolic functions (b540); water, mineral and electrolyte balance functions (b545); thermoregulatory functions (b550); sexual functions (b640); menstruation functions (b650)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni di produzione e regolazione dei livelli ormonali nel corpo, inclusi i cambiamenti ciclici.

Inclusioni: funzioni dellÃ¢â‚¬â„¢equilibrio ormonale; iperpituitarismo, ipopituitarismo, ipertiroidismo, ipotiroidismo, ipersurrenalismo, iposurrenalismo, iperparatiroidismo, ipoparatiroidismo, ipergonadismo, ipogonadismo

Esclusioni: funzioni metaboliche generali (b540); funzioni del bilancio idrico, minerale ed elettrolitico (b545); funzioni di termoregolazione (b550); funzioni sessuali (b640); funzioni mestruali (b650)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni delle ghiandole endocrine"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Traumatic_Brain_Injury .

ICF-:b610 a ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury,
        ICF-:b610,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Urinary excretory functions"^^xsd:string ;
    ICF-:description """Functions of filtration and collection of the urine.
Inclusions: functions of urinary filtration, collection of urine; impairments such as in renal insufficiency, anuria, oliguria, hydronephrosis, hypotonic urinary bladder and ureteric obstruction
Exclusions: urination functions (b620)"""^^xsd:string ;
    ICF-:descrizioneITA """Funzioni di filtrazione e raccolta dellÃ¢â‚¬â„¢urina.

Inclusioni: funzioni di filtrazione dellÃ¢â‚¬â„¢urina, raccolta dellÃ¢â‚¬â„¢urina; menomazioni come nellÃ¢â‚¬â„¢insufficienza renale, anuria, oliguria, idronefrosi, vescica ipotonica e ostruzione ureterale

Esclusione: funzioni urinarie (b620)"""^^xsd:string ;
    ICF-:nomeIta "Funzioni urinarie escretorie"^^xsd:string ;
    rdfs:subClassOf ICF-:Body_functions,
        ICF-:Spinal_Cord_Injury .

