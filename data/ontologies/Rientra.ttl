        owl:NamedIndividual ;
    rdfs:label "Discussion with one person"^^xsd:string ;
    ICF-:description "Initiating, maintaining, shaping or terminating an argument or debate with one person."@en ;
    rdfs:subClassOf ICF-:d355 .

ICF-:d3551 a ICF-:d355,
        ICF-:d3551,
