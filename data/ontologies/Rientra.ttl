        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Throwing"^^xsd:string ;
    ICF-:description "Using fingers, hands and arms to lift something and propel it with some force through the air, such as when tossing a ball."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d445,
        Rien2:Hand_Conditions .

ICF-:d4600 a ICF-:Spinal_Cord_Injury,
        ICF-:d460,
        ICF-:d4600,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moving around within the home"^^xsd:string ;
    ICF-:description """Walking and moving around in one's home, within a room, between rooms, and around the whole residence or living area.

Inclusions: moving from floor to floor, on an attached balcony, moving in a restricted area such as a courtyard, porch or garden"""@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d460 .

ICF-:d4601 a ICF-:Spinal_Cord_Injury,
        ICF-:d460,
        ICF-:d4601,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moving around within buildings other than home"^^xsd:string ;
    ICF-:description """Walking and moving around within buildings other than one's residence, such as other people's homes, other private buildings, community and public buildings and enclosed areas.

Inclusions: moving throughout all parts of buildings and enclosed areas, between floors, inside, outside and around buildings, both public and private"""@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d460 .

ICF-:d4602 a ICF-:Spinal_Cord_Injury,
        ICF-:d460,
        ICF-:d4602,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moving around outside the home and other buildings"^^xsd:string ;
    ICF-:description """Walking and moving around close to or far from one's home and other buildings, without the use of transportation, public or private, such as walking for short or long distances around a town or village.

Inclusions: walking or moving down streets in the neighbourhood, town, village or city; moving between cities, without using transportation"""@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d460 .

ICF-:d470 a ICF-:Activities_and_participation,
        ICF-:Spinal_Cord_Injury,
