    rdfs:label "Pushing"^^xsd:string ;
    ICF-:description "Using fingers, hands and arms to move something from oneself, or to move it from place to place, such as when pushing a toy or an animal away."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d445,
        Rien2:Hand_Conditions .

ICF-:d4452 a ICF-:Spinal_Cord_Injury,
        ICF-:d445,
        ICF-:d4452,
        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reaching"^^xsd:string ;
    ICF-:description "Using the hands and arms to extend outwards and touch and grasp something, such as when reaching across a table or desk for a book."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
        ICF-:d445,
