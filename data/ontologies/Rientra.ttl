        ICF-:b16701,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reception of written language"^^xsd:string ;
    ICF-:description "Mental functions of decoding written messages to obtain their meaning."^^xsd:string ;
    rdfs:subClassOf ICF-:b1670 .

ICF-:b16710 a ICF-:b1671,
        ICF-:b16710,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Expression of spoken language"^^xsd:string ;
