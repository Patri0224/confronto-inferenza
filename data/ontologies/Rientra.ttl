        Rien2:Hand_Conditions,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Turning or twisting the hands or arms"^^xsd:string ;
    ICF-:description "Using fingers, hands or arms to rotate, turn or bend an object as is required to open a jar or use tools such as a toothbrush or screwdriver."@en ;
    rdfs:subClassOf ICF-:Spinal_Cord_Injury,
